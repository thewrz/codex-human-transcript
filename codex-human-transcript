def payload_kind(record: dict[str, Any]) -> str | None:
    payload = record.get("payload")
    return payload.get("type") if isinstance(payload, dict) else None


def render(record: dict[str, Any]) -> str | None:
    payload = record.get("payload")
    if not isinstance(payload, dict):
        return None
    kind = str(payload.get("type") or "")
    stamp = str(record.get("timestamp", ""))[:19].replace("T", " ")
    handler = RENDERERS.get(kind)
    if handler is None and kind.endswith("approval_request"):
        handler = render_approval
    return handler(stamp, payload) if handler else None


def next_state(kind: str | None, state: str) -> str:
    if kind == "task_started":
        return "working"
    if kind == "task_complete":
        return "done"
    if kind in {"error", "task_failed"}:
        return "error"
    return state


def records(stream: Iterable[str]):
    for line in stream:
        try:
            record = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(record, dict):
            yield record


class Deduper:
    """Codex logs the same assistant/user text twice (event_msg + response_item)."""

    def __init__(self, window: int = 4):
        self.recent: deque[tuple[str, str]] = deque(maxlen=window)

    def fresh(self, rendered: str) -> bool:
        head, _, body = strip_ansi(rendered).partition("\n")
        key = (head.split("  ")[0], body)
        if key in self.recent:
            return False
        self.recent.append(key)
        return True


