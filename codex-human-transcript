class Style:
    def __init__(self, enabled: bool):
        self.enabled = enabled

    def paint(self, code: str, text: str) -> str:
        return f"\033[{code}m{text}\033[0m" if self.enabled else text


STYLE = Style(False)


# ── NDJSON → readable text ──────────────────────────────────────────────────

REDACTED = "[REDACTED]"


def redact(value: Any, depth: int = 0) -> Any:
    """Recursively mask values whose key looks secret; leaves other values untouched."""
    if depth > 12:
        return REDACTED if isinstance(value, (dict, list)) else value
    if isinstance(value, dict):
        return {str(k): (REDACTED if SECRET_KEYS.search(str(k)) else redact(v, depth + 1))
                for k, v in value.items()}
    if isinstance(value, list):
        return [redact(item, depth + 1) for item in value]
    return value


def clean(value: Any, limit: int = 1200) -> str:
    dumped = not isinstance(value, str)
    if isinstance(value, (dict, list)):
        value = redact(value)
    text = value if isinstance(value, str) else json.dumps(value, ensure_ascii=False)
    # Strip any terminal escape sequences the untrusted source embedded (OSC/DCS/APC/PM/SOS,
    # CSI) before this text is ever styled or printed — see UNTRUSTED_STRING_SEQ_RE above.
    text = UNTRUSTED_STRING_SEQ_RE.sub("", text)
    text = UNTRUSTED_CSI_RE.sub("", text)
    text = text.replace("\033", "")  # catch-all for any other ESC-introduced sequence
    text = re.sub(r"gAAAA[A-Za-z0-9_-]{40,}", "[ENCRYPTED/REDACTED]", text)
    text = re.sub(r"(Bearer\s+)[^\s\"']+", r"\1[REDACTED]", text, flags=re.I)
    text = re.sub(r"data:image/[A-Za-z0-9.+-]+;base64,[A-Za-z0-9+/=_-]{64,}",
                  "⟦inline image⟧", text)
    text = re.sub(r"[A-Za-z0-9+/=_-]{300,}", "⟦blob⟧", text)
    if dumped:  # only JSON-escaped text carries escape sequences worth unescaping
        text = text.replace("\\r\\n", "\n").replace("\\n", "\n").replace("\\t", "    ")
    return text if len(text) <= limit else text[: limit - 1] + "…"


def text_from_content(content: Any) -> str:
    if not isinstance(content, list):
        return ""
    parts = []
    for item in content:
        if isinstance(item, dict) and item.get("type") in {"output_text", "input_text"}:
            parts.append(str(item.get("text", "")))
    return "\n".join(p for p in parts if p)


def texts_from_json_list(value: Any) -> str | None:
    """Codex tool outputs are often a list of {"type":"text","text":…} — raw or JSON-encoded."""
    parsed = value
    if isinstance(value, str):
        try:
            parsed = json.loads(value)
        except json.JSONDecodeError:
            return None
    if not isinstance(parsed, list):
        return None
    chunks = [str(item["text"]) for item in parsed
              if isinstance(item, dict) and item.get("text")]
    if not chunks:
        return None
    return re.sub(r'\s*"\}\]\s*$', "", "\n".join(chunks))


def readable_tool_output(value: Any) -> str:
    text = texts_from_json_list(value)
    return clean(text) if text is not None else clean(value)


EXEC_EXIT_RE = re.compile(r"Process exited with code (-?\d+)")
EXEC_WALL_RE = re.compile(r"Wall time: ([\d.]+) seconds")
EXEC_NOISE = ("Chunk ID:", "Original token count:")


def split_exec_header(text: str) -> tuple[str, str]:
    """Collapse Codex's exec_command header block into one summary line."""
    lines = text.split("\n", 8)
    for i, line in enumerate(lines[:8]):
        if line.strip() != "Output:":
            continue
        head, body = lines[:i], "\n".join(lines[i + 1:])
        summary = []
        for entry in head:
            if entry.startswith(EXEC_NOISE):
                continue
            exit_match, wall_match = EXEC_EXIT_RE.match(entry), EXEC_WALL_RE.match(entry)
            if exit_match:
                summary.append(f"exit {exit_match.group(1)}")
            elif wall_match:
                summary.append(f"{float(wall_match.group(1)):.2f}s")
            elif entry.strip():
                summary.append(entry.strip())
        return " · ".join(summary), body
    return "", text


MD_ON = True


def inline_md(line: str) -> str:
    line = re.sub(r"\*\*(.+?)\*\*", lambda m: STYLE.paint("1", m.group(1)), line)
    line = re.sub(r"(?<![`\w])\*([^*\s][^*]*?)\*(?!\w)", lambda m: STYLE.paint("3", m.group(1)), line)
    line = re.sub(r"`([^`]+)`", lambda m: STYLE.paint("93", m.group(1)), line)
    line = re.sub(r"\[([^\]]+)\]\(([^)]+)\)",
                  lambda m: STYLE.paint("4;36", m.group(1)) + STYLE.paint("2", f" ({m.group(2)})"), line)
    return line


def md_ansi(text: str) -> str:
    """Tiny markdown → ANSI: headings, bold/italic/code, fences, bullets, quotes, links."""
    out = []
    in_code = False
    for line in text.splitlines():
        stripped = line.strip()
        if stripped.startswith("```"):
            in_code = not in_code
            lang = stripped[3:].strip()
            out.append(STYLE.paint("90", "┄┄ " + (lang or "code") + " ┄┄"))
            continue
        if in_code:
            out.append(STYLE.paint("33", line))
            continue
        heading = re.match(r"(#{1,6})\s+(.*)", stripped)
        if heading:
            out.append(STYLE.paint("1;4;36", heading.group(2)))
            continue
        if stripped.startswith(">"):
            out.append(STYLE.paint("2;3", line.replace(">", "┃", 1)))
            continue
        if re.match(r"\s*([-*_])\s*\1\s*\1[\s\-*_]*$", line):
            out.append(STYLE.paint("90", "─" * 30))
            continue
        line = re.sub(r"^(\s*)[-*+]\s+", lambda m: m.group(1) + STYLE.paint("36", "•") + " ", line)
        line = re.sub(r"^(\s*)(\d+)\.\s+", lambda m: m.group(1) + STYLE.paint("36", m.group(2) + ".") + " ", line)
        out.append(inline_md(line))
    return "\n".join(out)


def prose(text: str) -> str:
    return md_ansi(text) if MD_ON else text


def block(stamp: str, color: str, badge: str, body: str) -> str:
    """A titled block: glyph badge + dim timestamp, body behind a colored gutter rail."""
    head = STYLE.paint("1;" + color, badge) + (STYLE.paint("90", f"  {stamp}") if stamp else "")
    rail = STYLE.paint(color, "▎")
    lines = [head]
    lines.extend(f"{rail} {line}" for line in body.splitlines() or [""])
    return "\n".join(lines) + "\n"


def parse_json_object(value: Any) -> dict[str, Any] | None:
    if isinstance(value, dict):
        return value
    if not isinstance(value, str):
        return None
    try:
        parsed = json.loads(value)
    except json.JSONDecodeError:
        return None
    return parsed if isinstance(parsed, dict) else None


def kv_lines(args: dict[str, Any], limit: int = 400) -> str:
    safe = redact(args)
    return "\n".join(f"{key}: {clean(value, limit)}" for key, value in safe.items())


