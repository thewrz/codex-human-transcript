def render_mcp(stamp: str, payload: dict[str, Any]) -> str | None:
    invocation = parse_json_object(payload.get("invocation")) or {}
    label = f"{invocation.get('server', '?')}/{invocation.get('tool', '?')}"
    result = parse_json_object(payload.get("result")) or {}
    content = (result.get("Ok") or {}).get("content") if isinstance(result.get("Ok"), dict) else None
    body = texts_from_json_list(json.dumps(content)) if content else None
    if body is None:
        body = clean(result.get("Err", result) if result else payload.get("result", ""))
    return block(stamp, "33", f"⚙ MCP ⇠ {label}", clean(body))


