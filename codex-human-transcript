SNIFF_BYTES = 262144      # how much of an undecided file to read while sniffing its format
SNIFF_RECORDS = 50        # how many leading lines of that sniff to try to parse as JSON
SCAN_CHUNK = 65536        # backward state scan starts with this many bytes and doubles per pass
MAX_SCAN_BYTES = 16 * 1048576  # ...until this ceiling, beyond which state is reported as unknown
