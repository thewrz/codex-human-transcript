def render_codex(stamp: str, payload: dict[str, Any]) -> str | None:
    return block(stamp, "36", "◆ CODEX", prose(clean(payload.get("message", ""))))


def render_done(stamp: str, payload: dict[str, Any]) -> str | None:
    return block(stamp, "32", "✔ DONE", prose(clean(payload.get("last_agent_message", ""))))


def render_you(stamp: str, payload: dict[str, Any]) -> str | None:
    return block(stamp, "35", "❯ YOU", prose(clean(payload.get("message", payload.get("text", "")))))


def render_message(stamp: str, payload: dict[str, Any]) -> str | None:
    role = payload.get("role", "assistant")
    if role in {"developer", "system"}:
        return None
    message = text_from_content(payload.get("content"))
    if not message:
        return None
    if role == "user":
        return block(stamp, "35", "❯ YOU", prose(clean(message)))
    return block(stamp, "36", "◆ CODEX", prose(clean(message)))


def render_custom_tool_call(stamp: str, payload: dict[str, Any]) -> str | None:
    name = str(payload.get("name", "tool"))
    body = payload.get("input", "")
    if name == "exec" and isinstance(body, str):
        return block(stamp, "33", "⚙ EXEC ⇢", "$ " + clean(body))
    return block(stamp, "33", f"⚙ TOOL ⇢ {name}", clean(body))


def render_custom_tool_output(stamp: str, payload: dict[str, Any]) -> str | None:
    return block(stamp, "33", "⚙ TOOL ⇠", readable_tool_output(payload.get("output", "")))


def render_function_call(stamp: str, payload: dict[str, Any]) -> str | None:
    name = str(payload.get("name", "tool"))
    args = parse_json_object(payload.get("arguments")) or {}
    if name == "exec_command":
        body = "$ " + clean(str(args.get("cmd", "")))
        if args.get("workdir"):
            body += "\n" + STYLE.paint("90", f"in {args['workdir']}")
        return block(stamp, "33", "⚙ EXEC ⇢", body)
    if name == "write_stdin":
        return block(stamp, "33", "⚙ STDIN ⇢", clean(str(args.get("chars", ""))))
    if name == "wait":
        return block(stamp, "90", "⏳ WAIT", kv_lines(args))
    if name == "update_plan":
        return block(stamp, "34", "📋 PLAN", plan_lines(args))
    if name in AGENT_TOOLS:
        return block(stamp, "95", f"👥 AGENT ⇢ {name}", kv_lines(args))
    if not args:
        return block(stamp, "33", f"⚙ TOOL ⇢ {name}", clean(payload.get("arguments", "")))
    return block(stamp, "33", f"⚙ TOOL ⇢ {name}", kv_lines(args))


def plan_lines(args: dict[str, Any]) -> str:
    lines = []
    if args.get("explanation"):
        lines.append(clean(str(args["explanation"]), 300))
    for step in args.get("plan") or []:
        if not isinstance(step, dict):
            continue
        status = str(step.get("status", "pending"))
        glyph = PLAN_GLYPHS.get(status, "?")
        lines.append(f"{glyph} {clean(str(step.get('step', '')), 200)}  {STYLE.paint('90', status)}")
    return "\n".join(lines) or kv_lines(args)


def render_function_output(stamp: str, payload: dict[str, Any]) -> str | None:
    raw = payload.get("output", "")
    text = texts_from_json_list(raw)
    if text is None:
        text = raw if isinstance(raw, str) else json.dumps(raw, ensure_ascii=False)
    summary, body = split_exec_header(text)
    body = clean(body)
    if summary:
        body = STYLE.paint("90", summary) + ("\n" + body if body.strip() else "")
    return block(stamp, "33", "⚙ TOOL ⇠", body)


def render_patch(stamp: str, payload: dict[str, Any]) -> str | None:
    ok = str(payload.get("success", "")).lower() == "true"
    body = clean(str(payload.get("stdout", "")).rstrip())
    stderr = str(payload.get("stderr", "")).strip()
    if stderr:
        body += ("\n" if body else "") + clean(stderr)
    return block(stamp, "32" if ok else "31", "✎ PATCH" + ("" if ok else " FAILED"), body)


def render_search(stamp: str, payload: dict[str, Any]) -> str | None:
