SECRET_KEYS = re.compile(r"(token|secret|password|authorization|api[_-]?key|cookie)", re.I)
ANSI_RE = re.compile(r"\033\[([0-9;]*)m")
CTRL_RE = re.compile(r"[\x00-\x08\x0b-\x1a\x1c-\x1f]")
# Terminal escape sequences that untrusted transcript content can carry: OSC/DCS/APC/PM/SOS
# "string" sequences (ESC + one of ]PX^_ ... terminated by BEL or ST — e.g. OSC 52 clipboard
# writes) and CSI sequences (ESC [ ... final byte, which also covers SGR colour codes). Both
# match to end-of-string when the terminator is missing (mid-write truncation), so a dangling
# opener can't survive either. Used only on untrusted text in clean(), before the tool's own
# STYLE.paint() adds its trusted SGR codes.
UNTRUSTED_STRING_SEQ_RE = re.compile(r"\033[\]PX^_](?:[^\033\007]|\033(?!\\))*(?:\007|\033\\)?")
UNTRUSTED_CSI_RE = re.compile(r"\033\[[0-9:;<=>?]*[ -/]*[@-~]?")
MAX_CACHED_LINES = 8000
BACKFILL_BYTES = 512 * 1024
READ_CHUNK_BYTES = 1048576        # max bytes absorbed per tail pass
