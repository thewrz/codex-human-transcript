_UNSAFE_ID_CHARS = re.compile(r"[^A-Za-z0-9._-]")


def _safe_id_segment(value: str) -> str:
    """Make an attacker-controlled id both filesystem-safe AND collision-free.

    `owner_id`/`agent_id` are read verbatim from session content (e.g. a rollout file's own
    `session_meta.id`), so they must never be trusted as filesystem path segments. Stripping
    unsafe characters alone is not injective (`"a/b"` and `"ab"` would strip to the same
    string), so a short digest of the raw value is always appended to keep distinct ids
    distinct even after stripping.
    """
    cleaned = _UNSAFE_ID_CHARS.sub("", value)
    digest = hashlib.sha256(value.encode("utf-8")).hexdigest()[:8]
    return f"{cleaned}-{digest}" if cleaned else digest


def source_key(fmt_name: str, root: Path, owner_id: str, agent_id: str | None = None) -> str:
    """Stable, collision-free identity for one source file under one root."""
    digest = hashlib.sha256(str(Path(root).resolve()).encode("utf-8")).hexdigest()[:8]
    safe_owner = _safe_id_segment(owner_id)
    tail = f"-{_safe_id_segment(agent_id)}" if agent_id else ""
    return f"{fmt_name}-{digest}-{safe_owner}{tail}"


class Format:
    """Everything format-specific: discovery, metadata, rendering, state."""

    def __init__(self, name: str, tag: str, discover: Callable[[Path], list[SessionRef]],
                meta: Callable[[Path], dict[str, Any] | None],
                render: Callable[[dict[str, Any], dict[str, Any]], str | None],
                advance: Callable[[str, dict[str, Any]], str],
                scan_state: Callable[[Path], str], dedupe: bool,
                usage_feed: Callable[[dict[str, Any], dict[str, Any]], None],
                status: Callable[[SessionRef], str | None] | None = None):
        self.name = name
        self.tag = tag
        self.discover = discover
        self.meta = meta
        self.render = render
        self.advance = advance
        self.scan_state = scan_state
        self.dedupe = dedupe
        self.usage_feed = usage_feed
        self.status = status


class SessionRef(NamedTuple):
    fmt: Format
    path: Path
    kind: str                 # "main" | "subagent"
    session_id: str | None
    parent_id: str | None
    agent_id: str | None
    name: str
    role: str
    cwd: str | None
    mtime: float
    source_key: str


